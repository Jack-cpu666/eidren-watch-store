# LOCAL DEVELOPMENT ONLY. Keep .env private and out of Git.
DEBUG=true
DEMO_MODE=true
SECRET_KEY=
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Empty means local SQLite only when DEBUG=true. Production requires PostgreSQL.
DATABASE_URL=
DATABASE_REQUIRE_SSL=true

STORE_NAME=EIDREN
STORE_EMAIL=concierge@example.com
SHIPPING_COUNTRIES=US
# 0 means complimentary shipping. All amounts are USD cents.
SHIPPING_RATE_CENTS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable after configuring your Stripe Tax registrations and product tax codes.
STRIPE_AUTOMATIC_TAX=false

# Render sets RENDER_EXTERNAL_HOSTNAME; TLS proxy trust is then automatic.
# Only enable TRUST_PROXY_SSL elsewhere behind an ingress that replaces the header.
# TRUST_PROXY_SSL=false
# Comma-separated exact ingress CIDRs; leave empty until independently verified.
# Without this, forwarded IP headers are ignored. Username lockout still applies.
TRUSTED_PROXY_CIDRS=

# Optional operational SMTP settings; Stripe sends payment receipts separately.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
